# 生产部署环境变量模板（任务⑤）——复制为 .env 后填写（.env 已被 .gitignore 忽略）
# 缺失任一"必填"项时 `docker compose up` 会直接报错退出（不落弱默认，防误部署）。
# 本地开发不读本文件（compose.dev.yaml 自带最小配置；CI 不经 compose）。

# ---- MySQL（必填）----
# 生成强密码：openssl rand -base64 24
IM_MYSQL_PASSWORD=

# ---- 对象存储凭据（必填）----
# 生产接阿里云 OSS/腾讯 COS/MinIO 等 S3 兼容服务
IM_S3_ACCESS_KEY=
IM_S3_SECRET_KEY=

# ---- 对象存储公网地址（生产必配）----
# 预签名 PUT/GET 返回给外部客户端，Host 参与 SigV4 签名，必须是客户端可达域名。
# 留空=回落内网 endpoint（仅同网段联调可用，公网客户端将无法上传/下载）。
# 例：阿里云 OSS -> your-bucket.oss-cn-hangzhou.aliyuncs.com（publicScheme=https）
IM_S3_PUBLIC_ENDPOINT=
IM_S3_PUBLIC_SCHEME=https

# ---- 媒体对象键 HMAC 密钥（生产必配）----
# 生成：openssl rand -hex 32。留空用内置默认值（全网相同，链接可跨用户预测）
IM_MEDIA_HMAC_KEY=

# ---- 可选：WSS（nginx/im.conf 方案 B 启用后）----
# 证书放入 nginx/certs/ 并以域名命名，替换 im.conf 中 im.example.com
# IM_DOMAIN=im.example.com
